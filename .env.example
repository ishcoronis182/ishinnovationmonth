# PARTNER PULSE configuration. Copy to .env and fill in what you need.
# Every value has a working default: with none of these set, the tool runs the
# demo deck in offline mode on http://localhost:3000

# --- AI -----------------------------------------------------------------
# Without a key every AI step falls back to the deterministic heuristics and
# says so in the AI activity panel. The whole demo works offline.
ANTHROPIC_API_KEY=
PULSE_MODEL=claude-opus-5
PULSE_AI_EFFORT=medium
PULSE_AI_FALLBACKS=true
PULSE_AI_TIMEOUT_MS=45000

# --- Firm ---------------------------------------------------------------
PULSE_FIRM_NAME=Coronis Finance
PULSE_BROKER_NAME=Nathan
PULSE_OFFICE=Coronis Lutwyche
PULSE_TZ=Australia/Brisbane

# --- Server -------------------------------------------------------------
PORT=3000
PULSE_DATA_DIR=./data
PULSE_SEED_DEMO=true

# Set a passcode before this is reachable by anyone else. Without it the
# broker pages are open to whoever can reach the server.
PULSE_PASSCODE=

# The public origin, used for portal links and QR codes.
PULSE_PUBLIC_URL=

# --- Delivery -----------------------------------------------------------
# log (default) records the send and hands back sms: and mailto: links, so the
# broker's own phone is the pilot channel.
PULSE_SMS_PROVIDER=log
PULSE_EMAIL_PROVIDER=log

# Only needed when PULSE_SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Only needed when PULSE_EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=PARTNER PULSE <onboarding@resend.dev>
